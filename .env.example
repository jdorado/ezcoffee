# Local Compose profile. Copy to .env to customize; .env stays untracked.
# Production secrets belong outside this repository; see profiles/production.env.example.
COFFEE_WEB_PORT=5176
MONGO_DB=ezcoffee

# The open-source self-host profile is intentionally anonymous. For the
# authenticated hosted or personal profile, use APP_MODE=hosted or personal and
# set the Privy values below in the ignored runtime file. Hosted accounts are
# isolated by the verified Privy subject. Never commit PRIVY_APP_SECRET.
APP_MODE=selfhost
COFFEE_REQUIRE_AUTH=false
COFFEE_AI_ENABLED=false
PRIVY_APP_ID=
PRIVY_CLIENT_ID=
PRIVY_APP_SECRET=
COFFEE_OWNER_SUB=

# Optional equipment label and defaults for a new shot.
ESPRESSO_MACHINE_LABEL=
GRINDER_LABEL=
DEFAULT_DOSE_G=
DEFAULT_GRIND=
DEFAULT_BASKET=
DEFAULT_PAPER=unknown
DEFAULT_TEMP=
DEFAULT_PUCK_SCREEN=unknown
