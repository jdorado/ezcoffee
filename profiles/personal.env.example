# Private runtime profile. Store this on the target host and keep it secret.
COFFEE_ENV_FILE=/absolute/path/to/coffee.env
COFFEE_API_PORT=18084
COFFEE_CODEX_BASE_IMAGE=your-local-image-with-codex-cli
COFFEE_CODEX_SEED_DIR=/absolute/path/to/codex-seed
COFFEE_AGENT_INSTRUCTIONS_FILE=/absolute/path/to/personal-agent-instructions.md
COFFEE_CLI_VOLUME=coffee_cli_state
COFFEE_SHARE_CODEX_AUTH=0
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=medium
MONGO_DB=ezcoffee
