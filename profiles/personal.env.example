# Private runtime profile. Store this on the target host and keep it secret.
COFFEE_ENV_FILE=/absolute/path/to/coffee.env
COFFEE_API_PORT=18084
MONGO_DB=ezcoffee
# Private chat uses the standard Ez binding; no sidecar, provider keys, or
# model selection here. Ez owns sessions/context/reasoning/model choice.
COFFEE_AI_ENABLED=true
EZ_BINDINGS_FILE=/absolute/path/to/ez-bindings.json
