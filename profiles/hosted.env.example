# Install the real file as /etc/ezcoffee/hosted.env with mode 0600.
# It is read only by Docker Compose and must never be committed.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/
MONGO_DB=ezcoffee
PRIVY_APP_ID=<privy-app-id>
PRIVY_APP_SECRET=<privy-app-secret>
# Hosted chat stays off until the server-only key is present and this is true.
COFFEE_AI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
OPENROUTER_MAX_OUTPUT_TOKENS=1200
EZCOFFEE_API_PORT=18085
