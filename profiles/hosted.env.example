# Install the real file as /etc/ezcoffee/hosted.env with mode 0600.
# It is read only by Docker Compose and must never be committed.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/
MONGO_DB=ezcoffee
PRIVY_APP_ID=<privy-app-id>
PRIVY_APP_SECRET=<privy-app-secret>
# Hosted chat stays off until the Ez binding is present and this is true.
# Ez owns sessions/context/reasoning/model choice; the API owns auth and records.
COFFEE_AI_ENABLED=false
# Standard Ez binding reference (operator-provisioned, never committed).
# Points at the JSON registry mapping verified accounts to local Ez endpoints.
EZ_BINDINGS_FILE=/absolute/path/to/ez-bindings.json
# Optional private notifier. Leave blank for community/self-hosted deployments.
ANALYTICS_URL=
ANALYTICS_TOKEN=
EZCOFFEE_API_PORT=18085
